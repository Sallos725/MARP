# 기본 LLM 설정 (에이전트별 미지정 시 사용)
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_API_KEY=sk-...
DEFAULT_MODEL=gpt-4o-mini

# 세계관 에이전트 (비워두면 DEFAULT 사용)
WORLDBUILDING_BASE_URL=
WORLDBUILDING_API_KEY=
WORLDBUILDING_MODEL=

# 플롯 에이전트 (비워두면 DEFAULT 사용)
PLOT_BASE_URL=
PLOT_API_KEY=
PLOT_MODEL=

# 등장인물 에이전트 (비워두면 DEFAULT 사용)
CHARACTER_BASE_URL=
CHARACTER_API_KEY=
CHARACTER_MODEL=

# 검수 에이전트 — 품질이 중요하므로 강력한 모델 권장
REVIEWER_BASE_URL=
REVIEWER_API_KEY=
REVIEWER_MODEL=gpt-4o

# 파이프라인 설정
CONTEXT_WINDOW=10
DEBUG_MODE=false
REQUEST_TIMEOUT=60.0
