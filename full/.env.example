# 기본 LLM 설정 (에이전트별 미지정 시 사용)
DEFAULT_PROVIDER=openai
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_API_KEY=sk-...
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=
# OpenAI-compatible/Vertex 요청에 병합할 JSON object.
# Vercel AI Gateway 예시:
# {"providerOptions":{"gateway":{"caching":"auto","zeroDataRetention":true}}}
DEFAULT_EXTRA_BODY_JSON=

# 파이프라인 모드
# classic: 기존 세계관 -> 플롯 -> 캐릭터 순차 분석
# ensemble-director: 세계관/플롯/캐릭터 병렬 분석 후 디렉터가 검증/압축
# deep-ensemble: 3개 병렬 호출을 3라운드 직렬 실행해 총 9개 관점 주입
PIPELINE_MODE=classic

# 세계관 에이전트 (비워두면 DEFAULT 사용)
WORLDBUILDING_PROVIDER=
WORLDBUILDING_BASE_URL=
WORLDBUILDING_API_KEY=
WORLDBUILDING_MODEL=
WORLDBUILDING_TEMPERATURE=
WORLDBUILDING_MAX_TOKENS=
WORLDBUILDING_EXTRA_BODY_JSON=
WORLDBUILDING_SYSTEM_PROMPT=
WORLDBUILDING_USER_PROMPT_TEMPLATE=

# 플롯 에이전트 (비워두면 DEFAULT 사용)
PLOT_PROVIDER=
PLOT_BASE_URL=
PLOT_API_KEY=
PLOT_MODEL=
PLOT_TEMPERATURE=
PLOT_MAX_TOKENS=
PLOT_EXTRA_BODY_JSON=
PLOT_SYSTEM_PROMPT=
PLOT_USER_PROMPT_TEMPLATE=

# 등장인물 에이전트 (비워두면 DEFAULT 사용)
CHARACTER_PROVIDER=
CHARACTER_BASE_URL=
CHARACTER_API_KEY=
CHARACTER_MODEL=
CHARACTER_TEMPERATURE=
CHARACTER_MAX_TOKENS=
CHARACTER_EXTRA_BODY_JSON=
CHARACTER_SYSTEM_PROMPT=
CHARACTER_USER_PROMPT_TEMPLATE=

# 디렉터 에이전트 (ensemble-director 모드에서 사용, 비워두면 DEFAULT 사용)
DIRECTOR_PROVIDER=
DIRECTOR_BASE_URL=
DIRECTOR_API_KEY=
DIRECTOR_MODEL=
DIRECTOR_TEMPERATURE=
DIRECTOR_MAX_TOKENS=
DIRECTOR_EXTRA_BODY_JSON=
DIRECTOR_SYSTEM_PROMPT=
DIRECTOR_USER_PROMPT_TEMPLATE=

# deep-ensemble 에이전트는 GUI에서 개별 provider/model/key/prompt를 설정할 수 있다.
# 비워두면 DEFAULT 설정과 내장 프롬프트를 사용한다.

# 파이프라인 설정 — 분석 결과는 beforeRequest 훅으로 RisuAI 메인 모델 system 프롬프트에 주입됨
CONTEXT_WINDOW=10
DEBUG_MODE=false
REQUEST_TIMEOUT=60.0
# auto, ko, en, ja. GUI에서 덮어쓸 수 있음.
ANALYSIS_LANGUAGE=auto
